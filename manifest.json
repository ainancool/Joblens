{
  "manifest_version": 3,
  "name": "SG Job Lens",
  "version": "0.11.4",
  "description": "On LinkedIn job pages: Singapore salary ranges from MyCareersFuture, similar jobs, company review links, and one-click AI prompts.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.mycareersfuture.gov.sg/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "ai-send.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SG Job Lens：打开侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "打开 SG Job Lens 侧边栏"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://jooble.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}